# Copy to .env and load with `set -a; . ./.env; set +a`.
# The dashboard ("/" and "/generate") is locked until ADMIN_PASSWORD_HASH is set.
# The public tracking endpoint ("/log") works regardless.

# Admin username for the dashboard (HTTP Basic). Defaults to "admin".
ADMIN_USER=admin

# Admin password HASH (never a plaintext password). Generate one with:
#   python -c "from werkzeug.security import generate_password_hash as g; import getpass; print(g(getpass.getpass()))"
ADMIN_PASSWORD_HASH=

# Where logs.csv and links.csv are stored. Defaults to the app directory.
DATA_DIR=./data
